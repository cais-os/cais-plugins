{
  "description": "Cais team hooks — enforces Conventional Commits and plugin version bumps",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-commit-message.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-version-bump.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
