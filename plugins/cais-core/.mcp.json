{
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PAT}"
    }
  },
  "supabase-local": {
    "type": "http",
    "url": "http://localhost:54321/mcp"
  },
  "Railway": {
    "type": "stdio",
    "command": "npx",
    "args": ["@railway/mcp-server"],
    "env": {}
  },
  "next-devtools": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "next-devtools-mcp@latest"],
    "env": {}
  },
  "shadcn": {
    "type": "stdio",
    "command": "npx",
    "args": ["shadcn@latest", "mcp"],
    "env": {}
  },
  "trigger": {
    "type": "stdio",
    "command": "npx",
    "args": ["trigger.dev@latest", "mcp"],
    "env": {}
  },
  "n8n": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "mcp-remote", "${N8N_MCP_URL}", "--header", "Authorization: Bearer ${N8N_MCP_TOKEN}"],
    "env": {
      "MCP_MODE": "stdio",
      "LOG_LEVEL": "error",
      "DISABLE_CONSOLE_OUTPUT": "true"
    }
  },
  "digitalocean": {
    "type": "stdio",
    "command": "npx",
    "args": ["@digitalocean/mcp"],
    "env": {
      "DIGITALOCEAN_API_TOKEN": "${DIGITALOCEAN_API_TOKEN}"
    }
  },
  "redis": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run", "--rm", "--name", "redis-mcp-server", "-i",
      "-e", "REDIS_HOST=host.docker.internal",
      "-e", "REDIS_PORT=6379",
      "-e", "REDIS_USERNAME=default",
      "-e", "REDIS_PWD=",
      "mcp/redis"
    ],
    "env": {}
  },
  "postman": {
    "type": "stdio",
    "command": "npx",
    "args": ["@postman/postman-mcp-server", "--full"],
    "env": {
      "POSTMAN_API_KEY": "${POSTMAN_API_KEY}"
    }
  },
  "axiom": {
    "type": "http",
    "url": "https://mcp.axiom.co/mcp"
  },
  "canva": {
    "type": "http",
    "url": "https://mcp.canva.com/mcp"
  },
  "excalidraw": {
    "type": "http",
    "url": "https://mcp.excalidraw.com/mcp"
  },
  "figma": {
    "type": "http",
    "url": "https://mcp.figma.com/mcp"
  },
  "stripe-staging": {
    "type": "http",
    "url": "https://mcp.stripe.com"
  },
  "gmail": {
    "type": "http",
    "url": "https://gmail.mcp.claude.com/mcp"
  },
  "gcal": {
    "type": "http",
    "url": "https://gcal.mcp.claude.com/mcp"
  }
}
